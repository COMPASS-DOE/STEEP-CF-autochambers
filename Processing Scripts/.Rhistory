Date <- "20260607"
##Metadata only goes till 2026-06-04 10:00:12
#read in metadatfile
md <- (here::here("Processed_Data", paste0("COMPASS_TEMPESTX_SoilFluxes_8100_Metadata_processed_", Date, ".csv")))
metadat <- read.csv(md)
metadat_edited <- metadat %>%
mutate(
# Ensure it's a date-time object
start_time = ymd_hms(start_time),
# Extract date
Date = as.character(date(start_time)),
# Extract time
Time = format(start_time, "%H:%M:%S"),
#Parses the string as "minutes:seconds" and extracts the total duration in seconds from the period
total_seconds = as.numeric(ms(obs_length)),
#Add unique plot ID for each timestamp
unique_ID = paste("Collar", label, start_time, sep = "_"),
Vtotal_m3 = Vtotal/(100^3)) %>%
####Make changes to metadata####
mutate(Time = as_hms(Time)) %>%
#Change start time (label is the collar ID, can subtract 10-15 seconds, can also use the unique_ID for a specific collar+date+time combo)
mutate(
Time = case_when(
label == 15 ~ Time - 10,
label == 16 ~ Time - 10,
label == 49 ~ Time - 10,
label == 14 ~ Time - 15,
# unique_ID == "Collar_13_2026-06-03 15:59:13" ~ Time + 10,
TRUE ~ Time) ) %>%
mutate(Time = as.character(Time)) %>%
#Change observation length (a regular observation length is 90 seconds)
mutate(total_seconds = as.numeric(total_seconds)) %>%
mutate(total_seconds = case_when(
label == 15 ~ total_seconds - 30,
label == 16 ~ total_seconds - 30,
label == 49 ~ total_seconds - 30,
label == 14 ~ total_seconds - 45,
TRUE ~ total_seconds) ) %>%
#Add a flag here for times that are changed
mutate(flag = if_else(label %in% c(15, 16, 49), "Time changed", NA) ) %>%
# mutate(flag = if_else(unique_ID %in% c("Collar_13_2026-06-03 15:59:13"), "Time changed", NA) ) %>%
#Add a flag here for fluxes that are not usable
mutate(flag = if_else(label %in% c(14), "Flux unusable; need to check chamber in field", flag) )
##Write out edited metadata
write.csv(metadat_edited, file=here::here("Processed_Data", "COMPASS_TEMPESTX_SoilFluxes_8100_Metadata_processed_20260604.csv"), row.names = FALSE)           #Change file name
#Control metadata
