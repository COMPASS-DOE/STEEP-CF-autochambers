#match the metadata to the concentration data
fresh_alldat$metadat_row <- ffi_metadata_match(
data_timestamps = fresh_alldat$TIMESTAMP,
start_dates = fresh_metadat$Date,
start_times = fresh_metadat$Time,
obs_lengths = fresh_metadat$total_seconds)
# head(alldat)
#Set plot, temp, volume, etc. here
fresh_alldat$Plot <- fresh_metadat$unique_ID[fresh_alldat$metadat_row]
fresh_alldat$Volume <- fresh_metadat$Vtotal_m3[fresh_alldat$metadat_row]
fresh_alldat$final_temp <- fresh_metadat$Tcham[fresh_alldat$metadat_row] #from 8100 file
fresh_alldat$V2_avg <- fresh_metadat$V2_avg[fresh_alldat$metadat_row]
fresh_alldat$V3_avg <- fresh_metadat$V3_avg[fresh_alldat$metadat_row]
fresh_alldat$V4_avg <- fresh_metadat$V4_avg[fresh_alldat$metadat_row]
fresh_alldat$flag <- fresh_metadat$flag[fresh_alldat$metadat_row]
fresh_metadat$metadat_row <- seq_len(nrow(fresh_metadat))
### Need to deal with weird temperatures - probably take the one from the closest reasonable measurement
#remove the rows that don't match to metadata
fresh_alldat <- fresh_alldat %>%
filter(!is.na(metadat_row))
